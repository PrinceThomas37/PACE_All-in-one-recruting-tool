  section-label:   { type: label, marker: "10px square in the section colour", text: section-label }
  tab:             { type: tab, fill: cartridge-cream, active: "pixel-purple, cream text", border: "3px ink, no bottom" }
  list-card:       { type: card, fill: cartridge-cream, border: "3px ink", shadow: card, idTab: "record id in a small box hanging off the top-left edge", rows: ["name + job/company | amount", "1-2 tags", "owner avatar + time | stage trail"] }
  record:          { type: panel, fill: cartridge-cream, border: "3px ink", shadow: record, head: "record-title + id/date meta | client block", body: "facts grid, AI match bar, requirement table, stage chain" }
  decision-button: { type: button, height: "96px (phone 58px)", fills: ["sage = go", "brick = stop", "ochre = needs detail"], text: "button style, ink", glyph: "pixel ✓ ✕ ?", shortcut: "shown under the label" }
  primary-button:  { type: button, fill: sun-yellow, text: "ink, display font 10px", shadow: "4px 4px 0 #000" }
  tag:             { type: badge, border: "2px ink", fills: [cream, sage, brick, ochre, powder, lavender], text: tag }
  stage-trail:     { type: progress, cell: "16px square, 2px ink", done: sage, current: "ochre + letter", problem: "brick + !", not-yet: "dashed, empty" }
  stage-chain:     { type: progress, step: "bordered box: stage + who/when", you: ochre, next: dashed }
  match-bar:       { type: meter, segments: "11px blocks, 3px gaps (ONE element, a mask — not one div per block)", fill: pixel-purple, track: ruled-line, number: "display font, purple" }
  checks:          { type: card, rows: "label | PASS/SIGNED/CLEAR in leaf-text, warnings in rust-text" }
  activity-log:    { type: panel, fill: crt-black, text: log, verbs: sun-yellow, you: lavender-glow, scanlines: "1px every 3px", cursor: "blinking block on the last line" }
  avatar:          { type: avatar, shape: "28px square, 2px ink", text: "initials, pixel-label", fill: "a state colour, never photo" }
  pixel-icon:      { type: icon, grid: "9x9", size: "18px", rule: "every nav item has its own — the icon rail is icons only, two alike is a bug" }
  bottom-bar:      { type: nav, phone: true, items: 5, active: "fill = section colour" }
  search:          { type: input, fill: cartridge-cream, border: "3px ink", shadow: "4px 4px 0 #000", hint: "⌘K in a small ink box" }
