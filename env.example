SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here
JWT_SECRET=FuteGlobal_YourLongSecretKeyHere_2024
PORT=3000
NODE_ENV=production
ANTHROPIC_API_KEY=your_anthropic_key_here
MICROSOFT_TENANT_ID=your_azure_tenant_id
MICROSOFT_CLIENT_ID=your_azure_app_client_id
MICROSOFT_CLIENT_SECRET=your_azure_app_client_secret
MICROSOFT_REDIRECT_URI=https://fute-lms-backend.onrender.com/auth/microsoft/callback
# Shared secret for the background-engine heartbeat, GET /cron/tick?key=...
# Render's free tier sleeps this service when idle, which stops every recurring
# job. An external pinger (.github/workflows/heartbeat.yml) calls that endpoint
# to wake it and run whatever is due. Set this to a long random string and add
# the SAME value as a GitHub Actions secret named CRON_KEY.
# Leave unset and the endpoint stays closed (404) — the in-process intervals
# still work whenever the service happens to be awake.
CRON_KEY=a_long_random_string_here
GOOGLE_SHEETS_ID=your_google_sheet_id_here
# Gmail / Google Workspace sending (OPTIONAL — Microsoft works without these).
# Create an OAuth 2.0 Web app in Google Cloud Console, enable the Gmail API,
# and complete Google's verification for the restricted scopes gmail.send /
# gmail.modify before production use.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://fute-lms-backend.onrender.com/auth/google/callback
# Self-serve signup. OFF unless this is exactly "on".
#
# With it off (the default, and how the service ships), signing in with
# Microsoft or Google matches an EXISTING account and nothing else — a stranger
# gets "ask your administrator to add you". With it on, an address nobody
# recognises either joins the organisation that has VERIFIED a claim on its
# domain (and switched auto-join on), or gets a private workspace of its own.
#
# DO NOT SET THIS UNTIL MIGRATIONS 038 AND 039 ARE APPLIED. 038 creates the
# claimed-domain table this routes on; 039 is the isolation batch (RLS, org_id
# on the OAuth token tables) that has to be in place BEFORE a stranger can
# create a workspace, not after.
SELF_SERVE_SIGNUP=off
